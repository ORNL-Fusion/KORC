#!/bin/bash

set -ex

#define input file
INPUT_FILE="${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/input_file_FIO_M3DC1_alpha.korc"
#define output directory
OUT_DIR="fio_m3dc1_alpha_test/rank_$1"

#check that output directory doesn't exist so bash doesn't complain
if [ ! -d $OUT_DIR ]; then
  mkdir -p $OUT_DIR
fi
if [ ! -f C1.h5 ]; then
  ln -s ${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/C1.h5 C1.h5
  ln -s ${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/time_000.h5 time_000.h5
  ln -s ${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/time_001.h5 time_001.h5
  ln -s ${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/restart_file.h5 restart_file.h5
fi

${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} $1 ./xkorc $INPUT_FILE $OUT_DIR/

for i in $(seq 0 $(($1-1)));
do
  h5diff -r -p 0.000008 $OUT_DIR/file_$i.h5 ${CMAKE_SOURCE_DIR}/test/fio_m3dc1_alpha/rank_$1/file_$i.h5
done